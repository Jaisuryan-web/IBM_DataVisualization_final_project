      "source": [
        "import dash\n",
        "from dash import dcc, html\n",
        "from dash.dependencies import Input, Output\n",
        "import plotly.express as px\n",
        "import pandas as pd\n",
        "\n",
        "# 1. Create simple sample data\n",
        "data = {\n",
        "    \"Year\": [2018, 2019, 2020, 2021, 2022, 2023],\n",
        "    \"Sales\": [30, 45, 15, 40, 60, 75],\n",
        "    \"Profit\": [10, 20, 5, 15, 25, 30]\n",
        "}\n",
        "df = pd.DataFrame(data)\n",
        "\n",
        "# 2. Initialize the app\n",
        "app = dash.Dash(__name__)\n",
        "\n",
        "# 3. Create a clean, straightforward layout\n",
        "app.layout = html.Div([\n",
        "    html.H1(\"Project Dashboard\", style={'textAlign': 'center'}),\n",
        "\n",
        "    html.Label(\"Select Metric to Display:\"),\n",
        "    dcc.Dropdown(\n",
        "        id='metric-dropdown',\n",
        "        options=[\n",
        "            {'label': 'Yearly Sales', 'value': 'Sales'},\n",
        "            {'label': 'Yearly Profit', 'value': 'Profit'}\n",
        "        ],\n",
        "        value='Sales',  # Default starting value\n",
        "        style={'width': '50%'}\n",
        "    ),\n",
        "\n",
        "    dcc.Graph(id='main-graph')\n",
        "])\n",
        "\n",
        "# 4. Connect the dropdown to the graph\n",
        "@app.callback(\n",
        "    Output('main-graph', 'figure'),\n",
        "    Input('metric-dropdown', 'value')\n",
        ")\n",
        "def update_graph(selected_metric):\n",
        "    # Create an interactive line chart dynamically\n",
        "    fig = px.line(\n",
        "        df,\n",
        "        x='Year',\n",
        "        y=selected_metric,\n",
        "        title=f\"Trend Analysis: {selected_metric}\"\n",
        "    )\n",
        "    return fig\n",
        "\n",
        "# 5. Run the server\n",
        "if __name__ == '__main__':\n",
        "    app.run(debug=True)"
      ]
    }
  ]
}