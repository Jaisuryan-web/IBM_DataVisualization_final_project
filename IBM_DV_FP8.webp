            "\u001b[0;32m/usr/lib/python3.12/urllib/request.py\u001b[0m in \u001b[0;36mhttps_open\u001b[0;34m(self, req)\u001b[0m\n\u001b[1;32m   1390\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1391\u001b[0m         \u001b[0;32mdef\u001b[0m \u001b[0mhttps_open\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0mself\u001b[0m\u001b[0;34m,\u001b[0m \u001b[0mreq\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1392\u001b[0;31m             return self.do_open(http.client.HTTPSConnection, req,\n\u001b[0m\u001b[1;32m   1393\u001b[0m                                 context=self._context)\n\u001b[1;32m   1394\u001b[0m \u001b[0;34m\u001b[0m\u001b[0m\n",
            "\u001b[0;32m/usr/lib/python3.12/urllib/request.py\u001b[0m in \u001b[0;36mdo_open\u001b[0;34m(self, http_class, req, **http_conn_args)\u001b[0m\n\u001b[1;32m   1345\u001b[0m                           encode_chunked=req.has_header('Transfer-encoding'))\n\u001b[1;32m   1346\u001b[0m             \u001b[0;32mexcept\u001b[0m \u001b[0mOSError\u001b[0m \u001b[0;32mas\u001b[0m \u001b[0merr\u001b[0m\u001b[0;34m:\u001b[0m \u001b[0;31m# timeout error\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0;32m-> 1347\u001b[0;31m                 \u001b[0;32mraise\u001b[0m \u001b[0mURLError\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0merr\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[0m\u001b[1;32m   1348\u001b[0m             \u001b[0mr\u001b[0m \u001b[0;34m=\u001b[0m \u001b[0mh\u001b[0m\u001b[0;34m.\u001b[0m\u001b[0mgetresponse\u001b[0m\u001b[0;34m(\u001b[0m\u001b[0;34m)\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n\u001b[1;32m   1349\u001b[0m         \u001b[0;32mexcept\u001b[0m\u001b[0;34m:\u001b[0m\u001b[0;34m\u001b[0m\u001b[0;34m\u001b[0m\u001b[0m\n",
            "\u001b[0;31mURLError\u001b[0m: <urlopen error [Errno -5] No address associated with hostname>"
          ]
        }
      ],
      "source": [
        "import dash\n",
        "from dash import dcc, html\n",
        "from dash.dependencies import Input, Output\n",
        "import pandas as pd\n",
        "import plotly.express as px\n",
        "\n",
        "# 1. LOAD THE DATA\n",
        "# Make sure the data file path matches your project directory folder\n",
        "data_url = \"https://appdomain.cloud\"\n",
        "df = pd.read_csv(data_url)\n",
        "\n",
        "# 2. INITIALIZE THE DASH APP\n",
        "app = dash.Dash(__name__)\n",
        "\n",
        "# 3. DEFINE THE VISUAL DESIGN (LAYOUT)\n",
        "app.layout = html.Div([\n",
        "    html.H1(\"Automobile Sales Dashboard\", style={'textAlign': 'center', 'color': '#2C3E50', 'font-family': 'Arial'}),\n",
        "\n",
        "    # Selection Panel Box\n",
        "    html.Div([\n",
        "        html.Label(\"Select Report Type:\", style={'font-weight': 'bold'}),\n",
        "        dcc.Dropdown(\n",
        "            id='dropdown-statistics',\n",
        "            options=[\n",
        "                {'label': 'Recession Period Statistics', 'value': 'Recession Period Statistics'},\n",
        "                {'label': 'Yearly Statistics', 'value': 'Yearly Statistics'}\n",
        "            ],\n",
        "            placeholder='Select a report...',\n",
        "            style={'width': '280px', 'margin-bottom': '15px'}\n",
        "        ),\n",
        "\n",
        "        html.Label(\"Select Year (Only needed for Yearly Statistics):\", style={'font-weight': 'bold'}),\n",
        "        dcc.Dropdown(\n",
        "            id='select-year',\n",
        "            options=[{'label': str(i), 'value': i} for i in range(1980, 2024)],\n",
        "            placeholder='Select a year...',\n",
        "            disabled=True, # Starts turned off until Yearly Statistics is clicked\n",
        "            style={'width': '280px'}\n",
        "        )\n",
        "    ], style={'padding': '20px', 'backgroundColor': '#F8F9FA', 'borderRadius': '5px', 'margin-bottom': '20px'}),\n",
        "\n",
        "    # Empty container space where Dash outputs the final generated charts\n",
        "    html.Div(id='output-container', style={'display': 'flex', 'flex-wrap': 'wrap', 'justify-content': 'center'})\n",
        "])\n",
        "\n",
        "\n",
        "# 4. CONTROLLER FOR DROPDOWNS (Disables year dropdown if user clicks Recession)\n",
        "@app.callback(\n",
        "    Output('select-year', 'disabled'),\n",
        "    Input('dropdown-statistics', 'value')\n",
        ")\n",
        "def toggle_year_dropdown(selected_report):\n",
        "    if selected_report == 'Yearly Statistics':\n",
        "        return False  # Turn ON\n",
        "    return True       # Keep OFF\n",
        "\n",
        "\n",
        "# 5. CONTROLLER FOR CHART CREATION (The Core Engine)\n",
        "@app.callback(\n",
        "    Output('output-container', 'children'),\n",
        "    [Input('dropdown-statistics', 'value'),\n",
        "     Input('select-year', 'value')]\n",
        ")\n",
        "def update_dashboard(selected_report, selected_year):\n",
        "    # If nothing is chosen yet, don't show any blank placeholder graphics\n",
        "    if not selected_report:\n",
        "        return []\n",
        "\n",
        "    # CASE A: RECESSION REPORT LOGIC (The specific screenshot requirement for Question 6)\n",
        "    if selected_report == 'Recession Period Statistics':\n",
        "        # Filter data to keep only rows where Recession is active (equals 1)\n",
        "        recession_data = df[df['Recession'] == 1]\n",
        "\n",
        "        # Chart 1: Average Sales Trend over the years\n",
        "        chart1_data = recession_data.groupby('Year')['Automobile_Sales'].mean().reset_index()\n",
        "        fig1 = px.line(chart1_data, x='Year', y='Automobile_Sales',\n",
        "                       title=\"Automobile Sales Trend Across Recession Periods\")\n",
        "\n",
        "        # Chart 2: Average Vehicles Sold by Vehicle Type\n",
        "        chart2_data = recession_data.groupby('Vehicle_Type')['Automobile_Sales'].mean().reset_index()\n",
        "        fig2 = px.bar(chart2_data, x='Vehicle_Type', y='Automobile_Sales',\n",
        "                      title=\"Average Sales Volume by Vehicle Type\")\n",
        "\n",
        "        # Chart 3: Total Advertising Expenditure breakdown share\n",
        "        chart3_data = recession_data.groupby('Vehicle_Type')['Advertising_Expenditure'].sum().reset_index()\n",
        "        fig3 = px.pie(chart3_data, values='Advertising_Expenditure', names='Vehicle_Type',\n",
        "                      title=\"Total Advertising Expenditure Contribution Share\")\n",
        "\n",
        "        # Chart 4: Effect of Unemployment Rate on sales volume\n",
        "        fig4 = px.bar(recession_data, x='Unemployment_Rate', y='Automobile_Sales', color='Vehicle_Type',\n",
        "                      title=\"Effect of Unemployment Rate on Vehicle Type Sales Volume\")\n",
        "\n",
        "        # Package up all four generated recession graphs cleanly back to the page container\n",
        "        return [\n",
        "            html.Div(dcc.Graph(figure=fig1), style={'width': '48%', 'display': 'inline-block', 'padding': '10px'}),\n",
        "            html.Div(dcc.Graph(figure=fig2), style={'width': '48%', 'display': 'inline-block', 'padding': '10px'}),\n",
        "            html.Div(dcc.Graph(figure=fig3), style={'width': '48%', 'display': 'inline-block', 'padding': '10px'}),\n",
        "            html.Div(dcc.Graph(figure=fig4), style={'width': '48%', 'display': 'inline-block', 'padding': '10px'})\n",
        "        ]\n",
        "\n",
        "    # CASE B: YEARLY REPORT LOGIC\n",
        "    elif selected_report == 'Yearly Statistics' and selected_year:\n",
        "        yearly_data = df[df['Year'] == int(selected_year)]\n",
        "\n",
        "        chart1_data = df.groupby('Year')['Automobile_Sales'].mean().reset_index()\n",
        "        fig1 = px.line(chart1_data, x='Year', y='Automobile_Sales', title=\"Yearly Automobile Sales Trend\")\n",
        "\n",
        "        fig2 = px.line(yearly_data, x='Month', y='Automobile_Sales', title=f\"Monthly Automobile Sales for Year {selected_year}\")\n",
        "\n",
        "        chart3_data = yearly_data.groupby('Vehicle_Type')['Automobile_Sales'].mean().reset_index()\n",
        "        fig3 = px.bar(chart3_data, x='Vehicle_Type', y='Automobile_Sales', title=f\"Average Vehicles Sold by Type in {selected_year}\")\n",
        "\n",
        "        chart4_data = yearly_data.groupby('Vehicle_Type')['Advertising_Expenditure'].sum().reset_index()\n",
        "        fig4 = px.pie(chart4_data, values='Advertising_Expenditure', names='Vehicle_Type', title=f\"Advertising Expenditure Share in {selected_year}\")\n",
        "\n",
        "        return [\n",
        "            html.Div(dcc.Graph(figure=fig1), style={'width': '48%', 'display': 'inline-block'}),\n",
        "            html.Div(dcc.Graph(figure=fig2), style={'width': '48%', 'display': 'inline-block'}),\n",
        "            html.Div(dcc.Graph(figure=fig3), style={'width': '48%', 'display': 'inline-block'}),\n",
        "            html.Div(dcc.Graph(figure=fig4), style={'width': '48%', 'display': 'inline-block'})\n",
        "        ]\n",
        "\n",
        "    return []\n",
        "\n",
        "# 6. RUN SERVER RUN\n",
        "if __name__ == '__main__':\n",
        "    app.run_server(debug=True)"
      ]
    }
  ]
}